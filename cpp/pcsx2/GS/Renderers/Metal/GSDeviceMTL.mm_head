namespace
{
	static const char* shaderName(ShaderConvert value)
	{
		switch (value)
		{
			case ShaderConvert::COPY: return "ps_copy";
			case ShaderConvert::RGBA8_TO_16_BITS: return "ps_rgba8_to_16_bits";
			case ShaderConvert::DATM_1: return "ps_datm1";
			case ShaderConvert::DATM_0: return "ps_datm0";
			case ShaderConvert::DATM_1_RTA_CORRECTION: return "ps_datm1_rta_correction";
			case ShaderConvert::DATM_0_RTA_CORRECTION: return "ps_datm0_rta_correction";
			case ShaderConvert::COLCLIP_INIT: return "ps_colclip_init";
			case ShaderConvert::COLCLIP_RESOLVE: return "ps_colclip_resolve";
			case ShaderConvert::RTA_CORRECTION: return "ps_rta_correction";
			case ShaderConvert::RTA_DECORRECTION: return "ps_rta_decorrection";
			case ShaderConvert::TRANSPARENCY_FILTER: return "ps_transparency_filter";
			case ShaderConvert::FLOAT32_TO_16_BITS: return "ps_float32_to_16_bits";
			case ShaderConvert::FLOAT32_TO_32_BITS: return "ps_float32_to_32_bits";
			case ShaderConvert::FLOAT32_TO_RGBA8: return "ps_float32_to_rgba8";
			case ShaderConvert::FLOAT32_TO_RGB8: return "ps_float32_to_rgb8";
			case ShaderConvert::FLOAT16_TO_RGB5A1: return "ps_float16_to_rgb5a1";
			case ShaderConvert::RGBA8_TO_FLOAT32: return "ps_rgba8_to_float32";
			case ShaderConvert::RGBA8_TO_FLOAT24: return "ps_rgba8_to_float24";
			case ShaderConvert::RGBA8_TO_FLOAT16: return "ps_rgba8_to_float16";
			case ShaderConvert::RGB5A1_TO_FLOAT16: return "ps_rgb5a1_to_float16";
			case ShaderConvert::RGBA8_TO_FLOAT32_BILN: return "ps_rgba8_to_float32_biln";
			case ShaderConvert::RGBA8_TO_FLOAT24_BILN: return "ps_rgba8_to_float24_biln";
			case ShaderConvert::RGBA8_TO_FLOAT16_BILN: return "ps_rgba8_to_float16_biln";
			case ShaderConvert::RGB5A1_TO_FLOAT16_BILN: return "ps_rgb5a1_to_float16_biln";
			case ShaderConvert::FLOAT32_TO_FLOAT24: return "ps_float32_to_float24";
			case ShaderConvert::DEPTH_COPY: return "ps_depth_copy";
			case ShaderConvert::DOWNSAMPLE_COPY: return "ps_downsample_copy";
			case ShaderConvert::RGBA_TO_8I: return "ps_rgba_to_8i";
			case ShaderConvert::RGB5A1_TO_8I: return "ps_rgb5a1_to_8i";
			case ShaderConvert::CLUT_4: return "ps_clut_4";
			case ShaderConvert::CLUT_8: return "ps_clut_8";
			case ShaderConvert::YUV: return "ps_yuv";
			default: return "ps_copy";
		}
	}
}
